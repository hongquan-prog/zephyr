source "Kconfig.zephyr"

config I2C
	default $(dt_compat_on_bus,$(DT_COMPAT_WOLFSON_WM8731),i2c) \
		|| $(dt_compat_on_bus,$(DT_COMPAT_ADI_MAX9867),i2c)

config TOGGLE_ECHO_EFFECT_SW0
	bool "Toggle echo effect when pressing sw0"
	depends on $(dt_alias_enabled,sw0)
	select GPIO
	default y

config STOP_START_STREAMS_SW1
	bool "Start/stop I2S streams when pressing sw1"
	depends on $(dt_alias_enabled,sw1)
	select GPIO
	default y

config I2S_MCLK_FREQUENCY
	int "MCLK frequency in Hz"
	default 11289600
	help
	  Master clock frequency for the codec.  Defaults to
	  256 * 44100 Hz (standard for 44.1 kHz with 256× MCLK
	  ratio, used by ES8311 and similar codecs).

config APP_OUTPUT_VOLUME
	int "Output volume percentage (0-100)"
	default 50
	help
	  Volume level for the audio codec output.

config APP_INPUT_GAIN_DB
	int "Microphone gain in dB"
	default 6
	help
	  Microphone PGA gain for the audio codec input.
